# Copie para .env (ignorado pelo Git) e ajuste se precisar. Todos os valores são opcionais.
# Host: só loopback é aceito (127.0.0.1, ::1 ou localhost). Qualquer outro valor é recusado.
SALESOS_HOST=127.0.0.1
SALESOS_PORT=8000
# Caminho relativo à pasta de onde o SalesOS é iniciado (rode a partir da raiz do projeto).
SALESOS_DATABASE_URL=sqlite:///data/salesos.db
# Segredo dos tokens de formulário (mínimo de 32 caracteres). Sem valor, um novo é gerado a
# cada inicialização. Para fixar um, gere com o comando abaixo, descomente a linha e cole:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# SALESOS_SECRET_KEY=
